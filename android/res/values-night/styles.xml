<?xml version="1.0" encoding="utf-8"?>
<!-- The dark theme: the window's own background behind light icons. -->
<resources>
    <style name="App" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#17191C</item>
        <item name="android:navigationBarColor">#17191C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
