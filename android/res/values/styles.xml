<?xml version="1.0" encoding="utf-8"?>
<!-- The system's light or dark theme, as the phone is set, without a title bar.
     Light: dark icons on the status and navigation bars (values-night: light ones). -->
<resources>
    <style name="App" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#F7F7F5</item>
        <item name="android:navigationBarColor">#F7F7F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
